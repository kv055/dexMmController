{
  identity: {
    name: "Clawd",
    theme: "helpful assistant",
    emoji: "🦞",
  },

  env: {
    OPENROUTER_API_KEY: { source: "env", id: "OPENROUTER_API_KEY" },
  },

  logging: {
    level: "info",
    file: "/tmp/openclaw/openclaw.log",
    consoleLevel: "warn",
  },

  messages: {
    ackReaction: "👀",
  },

  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",
      userTimezone: "Europe/Berlin",
      model: {
        primary: "openrouter/anthropic/claude-sonnet-4-6",
        fallbacks: ["openrouter/google/gemini-2.5-pro"],
      },
      models: {
        "openrouter/anthropic/claude-sonnet-4-6": { alias: "primary" },
        "openrouter/google/gemini-2.5-pro": { alias: "fallback" },
      },
      heartbeat: {
        every: "0m",
        target: "last",
      },
      thinkingDefault: "low",
      verboseDefault: "off",
      elevatedDefault: "off",
      sandbox: {
        mode: "non-main",
      },
    },
  },

  session: {
    dmScope: "per-channel-peer",
  },

  tools: {
    profile: "coding",
  },

  // Gateway bound to all interfaces so docker-compose can reach it
  gateway: {
    mode: "local",
    port: 8001,
    bind: "all",
    auth: {
      mode: "token",
    },
    controlUi: {
      enabled: true,
    },
    reload: {
      mode: "hybrid",
    },
  },

  channels: {
    telegram: {
      enabled: true,
      botToken: "YOUR_TELEGRAM_BOT_TOKEN",
      dmPolicy: "allowlist",
      allowFrom: ["YOUR_TELEGRAM_USER_ID"],
      groupPolicy: "disabled",
    },
  },
}
