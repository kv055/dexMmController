# SQLite database file path
DB_PATH=./sqlite.db

# Shared Postgres runtime role for dexMmController
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dexarb
POSTGRES_USER=dex_mm_controller
POSTGRES_PASSWORD=dex_mm_controller
DATABASE_URL=postgres://dex_mm_controller:dex_mm_controller@localhost:5432/dexarb?sslmode=disable

# Hummingbot Backend API (v1.0.1, port 8000)
HUMMINGBOT_URL=http://localhost:8000
HUMMINGBOT_USERNAME=admin
HUMMINGBOT_PASSWORD=your_password_here

# OpenClaw WebSocket gateway
OPENCLAW_URL=ws://localhost:8080

# Offer Premium Calculation WebSocket stream
OFFER_PREMIUM_WSS_URL=wss://localhost:8080/offers/premium

# OpenClaw LLM API
OPENROUTER_API_KEY=your_openrouter_key_here

# How often the healthcheck loop runs (e.g. 30s, 1m, 5m)
HEALTHCHECK_INTERVAL=30s

# HodlHodl keys
HODLHODL_API_KEY=your_hodlhodl_api_key_here
HODLHODL_API_SIGNATURE_KEY=your_hodlhodl_api_secret_here

# Binance wallet bridge
BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Kraken wallet bridge
KRAKEN_API_BASE_URL=https://api.kraken.com
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_SECRET_KEY=your_kraken_secret_key_here
# Examples:
# KRAKEN_DEPOSIT_METHOD_BTC=Bitcoin
# KRAKEN_WITHDRAW_KEY_BTC=BTC_Wallet
# KRAKEN_LIGHTNING_DEPOSIT_METHOD_BTC=Bitcoin Lightning
# KRAKEN_LIGHTNING_WITHDRAW_METHOD_BTC=Bitcoin Lightning

# LND wallet password (used for encrypting and unlocking the wallet file)
LND_WALLET_PASSWORD=your_strong_password_here

# LND wallet secret input.
# Configure exactly one of:
# - LND_SEED_MNEMONIC_FILE for a 24-word aezeed mnemonic
# - LND_EXTENDED_MASTER_KEY_FILE for an xprv/tprv extended master key
#
# A single raw private key is not enough for LND's full wallet initialization.
LND_SEED_MNEMONIC_FILE=/run/secrets/lnd_seed_mnemonic
LND_AEZEED_PASSPHRASE_FILE=/run/secrets/lnd_aezeed_passphrase
# Optional lookahead when restoring from aezeed.
LND_RECOVERY_WINDOW=250

# Alternative to aezeed:
# LND_EXTENDED_MASTER_KEY_FILE=/run/secrets/lnd_extended_master_key
# Optional unix timestamp for the xprv/tprv wallet birthday.
# LND_EXTENDED_MASTER_KEY_BIRTHDAY_TIMESTAMP=1710000000
