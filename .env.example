# dexMmController — Environment Variables
# Copy this file to dexMmController/.env and fill in real secrets locally.
# Under docker-compose most values below are overridden by the compose
# `environment:` block (injected from the ROOT .env).
#
# NOTE: exchange API credentials (Binance, Kraken, HodlHodl, Hummingbot,
# OpenRouter), the LND wallet password, the Robosats robot token and similar
# operator secrets are managed in Postgres via the dexMonitor Accounts panel —
# NOT via this file. Any BINANCE_API_KEY / KRAKEN_API_KEY / HODLHODL_* /
# HUMMINGBOT_* / OPENROUTER_API_KEY / LND_WALLET_PASSWORD /
# OFFER_PREMIUM_WSS_URL entries lingering in a local .env are legacy and
# ignored by the current code; delete them and use the Accounts panel.
#
# SQLite database file path
DB_PATH=./sqlite.db
API_ADDR=:5001

# Shared Postgres runtime role for dexMmController
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dexarb
POSTGRES_USER=dex_mm_controller
POSTGRES_PASSWORD=dex_mm_controller
DATABASE_URL=postgres://dex_mm_controller:dex_mm_controller@localhost:5432/dexarb?sslmode=disable

# OpenClaw WebSocket gateway
OPENCLAW_URL=ws://localhost:8080

# How often the healthcheck loop runs (e.g. 30s, 1m, 5m)
HEALTHCHECK_INTERVAL=30s
# Alert after a Bisq buyer's fiat-sent signal remains unmatched for this long.
# Set to 0 to disable; this never auto-confirms fiat receipt or releases BTC.
BISQ_FIAT_ESCALATION_AFTER=2h
# Enables money-moving tradeflow recovery, DEX relay, and hedgeless pool refill.
# Keep false until the configured venues/accounts have passed staging validation.
ENABLE_AUTOMATED_TRADEFLOW_WORKERS=false

# Fiat-arrival safety gate for bid-side pre-trade checks. The heartbeat secret
# must match PUSHPUSH_HEARTBEAT_SECRET on dexFiatController.
FIAT_CONTROLLER_URL=http://fiat-controller:8080
FIAT_CONTROLLER_HEARTBEAT_SECRET=

# Binance wallet bridge
BINANCE_API_BASE_URL=https://api.binance.com

# Kraken wallet bridge
KRAKEN_API_BASE_URL=https://api.kraken.com
# Examples:
# KRAKEN_DEPOSIT_METHOD_BTC=Bitcoin
# KRAKEN_WITHDRAW_KEY_BTC=BTC_Wallet
# KRAKEN_LIGHTNING_DEPOSIT_METHOD_BTC=Bitcoin Lightning
# KRAKEN_LIGHTNING_WITHDRAW_METHOD_BTC=Bitcoin Lightning

# LND wallet password is stored in Postgres (accounts.password for the "LND wallet"
# account) and edited in the dexMonitor Accounts panel — not in this file.

# LND wallet secret input.
# These files are expected to be mounted from ./dexMmController/secrets/ in the
# repo-root docker-compose.yml mm-controller service.
#
# Configure exactly one of:
# - LND_SEED_MNEMONIC_FILE for a 24-word aezeed mnemonic
# - LND_EXTENDED_MASTER_KEY_FILE for an xprv/tprv extended master key
#
# A single raw private key is not enough for LND's full wallet initialization.
LND_SEED_MNEMONIC_FILE=/run/secrets/lnd_seed_mnemonic
LND_AEZEED_PASSPHRASE_FILE=/run/secrets/lnd_aezeed_passphrase
# Optional lookahead when restoring from aezeed.
LND_RECOVERY_WINDOW=250

# Alternative to aezeed:
# LND_EXTENDED_MASTER_KEY_FILE=/run/secrets/lnd_extended_master_key
# Preferred: mount the birthday timestamp as a file too.
# LND_EXTENDED_MASTER_KEY_BIRTHDAY_TIMESTAMP_FILE=/run/secrets/lnd_extended_master_key_birthday_timestamp
# Optional fallback if you prefer a plain env var:
# LND_EXTENDED_MASTER_KEY_BIRTHDAY_TIMESTAMP=1710000000

# RoboSats: coordinators are Tor onion services, so a SOCKS proxy is required.
# The repo-root docker-compose.yml sets TOR_PROXY_URL to the tor sidecar.
# Leave ROBOSATS_URL empty to probe all known coordinators during health checks;
# set it to pin a single coordinator. The robot token is stored in Postgres
# (api_keys for the "Robosats" account) and edited in the dexMonitor Accounts panel.
# TOR_PROXY_URL=socks5h://127.0.0.1:9050
# ROBOSATS_URL=
# Official Boltz API used for read-only submarine-swap quotes. Swap execution
# remains disabled until both fee ceilings are configured on the LSP channel.
BOLTZ_URL=https://api.boltz.exchange
# Amboss Magma BLIP-0051 LSP REST API for opening inbound LSP channels.
# MAGMA_LSP_BASE_URL=https://magma.amboss.tech/api/lsp/v1
# MAGMA_LSP_DEFAULT_POOL=recommended
# MAGMA_LSP_PAY_FEE_LIMIT_SAT=1000
# Amboss GraphQL API for browsing the Magma marketplace offer book (public).
# AMBOSS_GRAPHQL_URL=https://api.amboss.space/graphql
# AMBOSS_API_KEY=

# Bisq 2 Easy (REST + WebSocket on port 8090)
# BISQ2_REST_HOST=127.0.0.1:8090
# BISQ2_API_PASSWORD=

# Telegram trade-chat relay + anomaly alerts (shared bot token with fiat-controller pushpush)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public URL Telegram should POST operator replies to (dexMmController /telegram-webhook)
DEXMM_TELEGRAM_WEBHOOK_URL=
# Inbound /telegram-webhook posts are rejected unless they echo this back
# (fail-closed when unset). Injected from the ROOT .env under docker-compose.
TELEGRAM_WEBHOOK_SECRET=

# --- Compose-injected runtime (ROOT .env under docker-compose) ---
# Internal API secret: standalone runs need it here; compose injects it.
INTERNAL_API_SECRET=
# Intentionally run the internal endpoints open (dev only, default secure).
ALLOW_INSECURE_INTERNAL=
# 32-byte base64 key for Postgres credential encryption.
APP_ENCRYPTION_KEY=
# Bisq daemons on the bridge network (compose: bisq:9998 / bisq2:8090).
BISQ_GRPC_HOST=localhost:9998
BISQ_API_PASSWORD=
BISQ2_REST_HOST=localhost:8090
BISQ2_API_PASSWORD=
# How often CEX account health/permission snapshots refresh (default 10m).
ACCOUNT_HEALTH_INTERVAL=10m
# A successful CEX permission snapshot older than this is no longer trusted.
MM_CEX_CAPABILITY_MAX_AGE=30m
# LND runtime (compose pins these on the bridge network; password stays in Postgres).
LND_HOST=https://localhost:8080
LND_MACAROON_PATH=/lnd/data/chain/bitcoin/mainnet/admin.macaroon
LND_TLS_CERT_PATH=/lnd/tls.cert
LND_BITCOIND_RPCUSER=
LND_BITCOIND_RPCPASS=
LND_INIT_FRESH=false
LND_VERSION=0.18.4-beta
# Trade-size safety caps read by the cexaccount service (unset = built-in defaults).
MAX_MARKET_BUY_BTC=
MAX_HEDGE_BTC=
# Kraken Futures override (unset = built-in default).
KRAKEN_FUTURES_API_BASE_URL=
# How long a completed tradeflow stays recoverable (default 3m).
TRADEFLOW_RECOVERY_GRACE=3m
# Interval for encrypted LND backups (unset = account health interval).
LND_BACKUP_INTERVAL=
# DEX-release webhook bearer secret. Injected from PUSHPUSH_DEX_RELEASE_TOKEN
# in the ROOT .env under docker-compose; empty disables the webhook (503).
DEX_RELEASE_WEBHOOK_TOKEN=
# HodlHodl escrow overrides (credentials themselves live in Postgres).
HODLHODL_URL=
HODLHODL_ESCROW_SEED=
HODLHODL_ESCROW_PAYMENT_PASSWORD=
# CEX bridge base-URL overrides (unset = built-in defaults).
COINBASE_API_BASE_URL=
COINBASE_INTX_API_BASE_URL=
# LND bitcoind RPC proxy URL (compose pins http://bitcoind-rpc-proxy:8332).
LND_BITCOIND_RPC_URL=
# Displayed daemon versions (compose pins BISQ_VERSION=1.10.7, BISQ2_VERSION=2.1.11
# to match the built images; do not set these by hand).
# BISQ_VERSION=
# BISQ2_VERSION=
# Standalone fallback heartbeat secret when FIAT_CONTROLLER_HEARTBEAT_SECRET is
# unset (compose always sets FIAT_CONTROLLER_HEARTBEAT_SECRET from the ROOT .env).
PUSHPUSH_HEARTBEAT_SECRET=
