# SQLite database file path
DB_PATH=./sqlite.db

# Shared Postgres runtime role for dexMmController
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dexarb
POSTGRES_USER=dex_mm_controller
POSTGRES_PASSWORD=dex_mm_controller
DATABASE_URL=postgres://dex_mm_controller:dex_mm_controller@localhost:5432/dexarb?sslmode=disable

# OpenClaw WebSocket gateway
OPENCLAW_URL=ws://localhost:8080

# Offer Premium Calculation WebSocket stream
OFFER_PREMIUM_WSS_URL=wss://localhost:8080/offers/premium

# How often the healthcheck loop runs (e.g. 30s, 1m, 5m)
HEALTHCHECK_INTERVAL=30s
# Enables money-moving tradeflow recovery, DEX relay, and hedgeless pool refill.
# Keep false until the configured venues/accounts have passed staging validation.
ENABLE_AUTOMATED_TRADEFLOW_WORKERS=false

# Fiat-arrival safety gate for bid-side pre-trade checks. The heartbeat secret
# must match PUSHPUSH_HEARTBEAT_SECRET on dexFiatController.
FIAT_CONTROLLER_URL=http://fiat-controller:8080
FIAT_CONTROLLER_HEARTBEAT_SECRET=

# Binance wallet bridge
BINANCE_API_BASE_URL=https://api.binance.com

# Kraken wallet bridge
KRAKEN_API_BASE_URL=https://api.kraken.com
# Examples:
# KRAKEN_DEPOSIT_METHOD_BTC=Bitcoin
# KRAKEN_WITHDRAW_KEY_BTC=BTC_Wallet
# KRAKEN_LIGHTNING_DEPOSIT_METHOD_BTC=Bitcoin Lightning
# KRAKEN_LIGHTNING_WITHDRAW_METHOD_BTC=Bitcoin Lightning

# LND wallet password is stored in Postgres (accounts.password for the "LND wallet"
# account) and edited in the dexMonitor Accounts panel — not in this file.

# LND wallet secret input.
# These files are expected to be mounted from ./dexMmController/secrets/ in the
# repo-root docker-compose.yml mm-controller service.
#
# Configure exactly one of:
# - LND_SEED_MNEMONIC_FILE for a 24-word aezeed mnemonic
# - LND_EXTENDED_MASTER_KEY_FILE for an xprv/tprv extended master key
#
# A single raw private key is not enough for LND's full wallet initialization.
LND_SEED_MNEMONIC_FILE=/run/secrets/lnd_seed_mnemonic
LND_AEZEED_PASSPHRASE_FILE=/run/secrets/lnd_aezeed_passphrase
# Optional lookahead when restoring from aezeed.
LND_RECOVERY_WINDOW=250

# Alternative to aezeed:
# LND_EXTENDED_MASTER_KEY_FILE=/run/secrets/lnd_extended_master_key
# Preferred: mount the birthday timestamp as a file too.
# LND_EXTENDED_MASTER_KEY_BIRTHDAY_TIMESTAMP_FILE=/run/secrets/lnd_extended_master_key_birthday_timestamp
# Optional fallback if you prefer a plain env var:
# LND_EXTENDED_MASTER_KEY_BIRTHDAY_TIMESTAMP=1710000000

# RoboSats: coordinators are Tor onion services, so a SOCKS proxy is required.
# The repo-root docker-compose.yml sets TOR_PROXY_URL to the tor sidecar.
# Leave ROBOSATS_URL empty to probe all known coordinators during health checks;
# set it to pin a single coordinator. The robot token is stored in Postgres
# (api_keys for the "Robosats" account) and edited in the dexMonitor Accounts panel.
# TOR_PROXY_URL=socks5h://127.0.0.1:9050
# ROBOSATS_URL=
# Official Boltz API used for read-only submarine-swap quotes. Swap execution
# remains disabled until both fee ceilings are configured on the LSP channel.
BOLTZ_URL=https://api.boltz.exchange
# Amboss Magma BLIP-0051 LSP REST API for opening inbound LSP channels.
# MAGMA_LSP_BASE_URL=https://magma.amboss.tech/api/lsp/v1
# MAGMA_LSP_DEFAULT_POOL=recommended
# MAGMA_LSP_PAY_FEE_LIMIT_SAT=1000
# Amboss GraphQL API for browsing the Magma marketplace offer book (public).
# AMBOSS_GRAPHQL_URL=https://api.amboss.space/graphql
# AMBOSS_API_KEY=

# Bisq 2 Easy (REST + WebSocket on port 8090)
# BISQ2_REST_HOST=127.0.0.1:8090
# BISQ2_API_PASSWORD=

# Telegram trade-chat relay + anomaly alerts (shared bot token with fiat-controller pushpush)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Public URL Telegram should POST operator replies to (dexMmController /telegram-webhook)
# DEXMM_TELEGRAM_WEBHOOK_URL=
